{
  "name": "krovinox-storefront",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.20.0 <23"
  },
  "packageManager": "npm@10.9.9",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:tokens": "node scripts/check-design-tokens.mjs",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run check:tokens && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
